            <value>https://mymaps.usercontent.google.com/hostedimage/m/*/3AAjQbR40a8Le_UGrrhMrgHaDlBX3nmCYDct2vGxT7XvlKzRFWLTZLr4SCA29lrIGptdX5uSwYW3a_9yoS3gFjHKNah7ELJWeFerJ-QEr53Z-W8km4ZpwzIDQCkWejGvkEUIWQYiWNSY6lorb8N7MggcAaQIVr9ADEY4VxTdLKOvRtQKyGRIWIQlkkffxZi2qnp4mnQZWbqORM1GC2lqTA4x0S00QKhs9hQvsKvJICQSWsjJNrB75Hbs8rC06NUY?fife=s16383</value>
